# Endereço público do site (usado em Open Graph, canonical e sitemap).
# Troque pelo endereço definitivo assim que o site estiver publicado.
VITE_SITE_URL=https://geovanacassimiro.vercel.app

# Opcional: ID de um formulário Formspree (https://formspree.io).
# Enquanto estiver vazio, a página de contato NÃO exibe formulário —
# apenas e-mail e redes. Defina em .env.local ou no painel da hospedagem.
VITE_FORMSPREE_ID=
